# Game Night Tools website base URL.
GNT_APP_URL=https://gamenights.sayrejeri.com

# Must exactly match BOT_WORKER_SECRET on the website deployment.
BOT_WORKER_SECRET=replace-with-the-same-long-worker-secret

# Discord bot token for the same Game Night Tools Discord application.
DISCORD_BOT_TOKEN=

# Optional worker identity shown in queue locks/logging.
BOT_WORKER_ID=four-seasons-main

# Queue polling frequency. Minimum enforced by the worker is 5 seconds.
BOT_POLL_SECONDS=10

# Scheduler scan frequency. Minimum enforced by the worker is 30 seconds.
BOT_SCHEDULE_SECONDS=60
