# Public URL of the deployed app. Do not include a trailing slash.
APP_URL=https://gamenights.sayrejeri.com

# A long random string used to sign login sessions.
AUTH_SECRET=replace-with-at-least-32-random-characters

# Discord Developer Portal OAuth application credentials.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://gamenights.sayrejeri.com/api/auth/discord/callback

# Optional v1.0 Discord bot beta credentials. The bot can use the same Discord application as OAuth.
# Keep the bot token server-side only and rotate it immediately if it is ever exposed.
DISCORD_BOT_TOKEN=
# Used to verify signed Discord HTTP interactions/slash commands.
DISCORD_PUBLIC_KEY=
# Shared only between the Game Night Tools website and the Four Seasons worker.
# Use a different long random secret from AUTH_SECRET/CODE_PEPPER.
BOT_WORKER_SECRET=replace-with-another-long-random-secret

# MariaDB/MySQL connection string.
DATABASE_URL=mysql://database_user:database_password@localhost:3306/database_name

# Jeremiah's Discord ID and any additional platform administrators.
PLATFORM_OWNER_DISCORD_IDS=YOUR_DISCORD_ID

# Optional extra secret mixed into invite-code hashes.
CODE_PEPPER=replace-with-another-random-secret
